---
layout: null
permalink: feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name | xml_escape }} - Articles</title>
    <description>{% if site.description %}{{ site.description | strip_html | normalize_whitespace | xml_escape }}{% endif %}</description>
    <link>{{ site.url }}</link>
    <atom:link href="{{ "/feed.xml" | absolute_url }}" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date: "%a, %d %b %Y %H:%M:%S %z" }}</lastBuildDate>
    <generator>Jekyll</generator>
    {% for post in site.posts %}
      {% unless post.link or post.unlisted %}
      {% assign post_author = site.data.authors[post.author] %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <link>{{ post.url | absolute_url }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
        <pubDate>{{ post.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
        <dc:creator>{% if post_author %}{{ post_author.name | xml_escape }}{% else %}{{ site.author.name | xml_escape }}{% endif %}</dc:creator>
        <description>{% if post.description %}{{ post.description | strip_html | normalize_whitespace | xml_escape }}{% else %}{{ post.excerpt | strip_html | normalize_whitespace | truncate: 300 | xml_escape }}{% endif %}</description>
        <content:encoded><![CDATA[{{ post.content }}]]></content:encoded>
        {% for category in post.categories %}<category>{{ category | xml_escape }}</category>
        {% endfor %}
      </item>
      {% endunless %}
    {% endfor %}
  </channel>
</rss>
